# Free key: https://aistudio.google.com/apikey  (never commit your real key; `npm start` loads .env automatically)
GEMINI_API_KEY=your-key-here
# Optional: try a specific model first (otherwise the newest free Flash models are chosen automatically)
# GEMINI_MODEL=gemini-3.5-flash
# Set to true when running behind a trusted proxy (Render sets RENDER automatically)
# TRUST_PROXY=true
PORT=3000
